# Copy this file to .env and fill in the first two values. Everything else has a default.

# https://the-odds-api.com
ODDS_API_KEY=
# Discord: Channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# ---- What to watch
# Sport keys. Out-of-season sports cost nothing (no games = no checks), so list freely.
SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl,baseball_mlb
# h2h (moneyline), spreads, totals. Each one adds 1 credit per check.
MARKETS=h2h,spreads,totals
# Bet types the live check asks for. Empty = the same as MARKETS (one check per sport, as always).
# h2h = opt in to the split below. Off by default: it checks spreads/totals of later games more often
# but their moneylines 30-55% less often in a sport with a live game (month simulation).
# Live checks are most of the bill, and each bet type costs a credit per check. With h2h, a sport
# with a live game is checked two ways: moneylines for every game (live and upcoming) every
# POLL_SECONDS, and spreads/totals of the games that haven't started every PREGAME_WITH_LIVE_EVERY
# live checks (live spreads/totals alerts stop). To check live games for everything again, list the
# same as MARKETS.
LIVE_MARKETS=
# ...that check of spreads/totals runs once every this many live checks: 1 = with every live check,
# every POLL_SECONDS (as before LIVE_MARKETS; a sport with a live game costs the same 3 credits a
# minute at full speed). It keeps that pace when live checks slow down to save credits: on a tight
# day the live check slows first (and the moneylines of upcoming games with it), then the early
# checks, and this one only if everything has to.
# 2 = every 2nd live check (2 credits a minute; spare credits speed it up first, to every live
# check at most). 0 = the normal pre-game pace (every 15 min near kickoff, hourly further out).
PREGAME_WITH_LIVE_EVERY=1
# Up to 10 books cost the same as ONE region, and they can come from any region.
# Pinnacle is only read, as the "true odds" reference for +EV; you never bet there.
# Swap in the books you have accounts at. Run `--once` to see which keys are in the feed.
# (Leave BOOKMAKERS empty to use REGIONS instead; +EV then needs the eu region for Pinnacle.)
BOOKMAKERS=pinnacle,draftkings,fanduel,betmgm,williamhill_us,kalshi,espnbet,betrivers,fanatics,hardrockbet
REGIONS=us
# The books you actually bet at. Alerts only ever tell you to bet at these; the other books in
# BOOKMAKERS are only used to judge the market (true odds, consensus). Empty = all of them.
MY_BOOKS=draftkings,fanduel,betmgm,williamhill_us,kalshi
# Kalshi charges a trading fee (rate x P x (1-P) per $1 contract). Its prices are lowered by the
# fee before any comparison. 0 = ignore fees.
KALSHI_FEE_RATE=0.07
# Your state's two-letter code (nj, ny, pa, mi, il, az, co, ...). BetMGM's links are per state.
# In New York, set US_STATE=ny.
US_STATE=
# New York's sportsbooks can't take bets on games with a New York college team (Syracuse, Army,
# Buffalo, St. John's, Cornell, ...). On = never alert those games at FanDuel, DraftKings, BetMGM,
# Caesars, BetRivers, Fanatics or Bally Bet (Kalshi still counts). Empty = on when US_STATE=ny.
# Betting in New York? Set NY_RULES=true (or US_STATE=ny). College games played IN New York
# between two out-of-state teams (e.g. the Pinstripe Bowl) aren't caught: skip those yourself.
NY_RULES=

# ---- Your plan
MONTHLY_CREDITS=100000
# Day of the month your credits reset (check your Odds API account page).
BILLING_DAY=1

# ---- Speed
# Fastest check rate while a sport has a game in progress. The bot slows down automatically
# only if needed to make credits last until BILLING_DAY.
POLL_SECONDS=60
# Slower checks shortly before kickoff (pre-game arbs last longer). 0 = live games only.
# +EV alerts are pre-game, so these matter for +EV: more often / earlier = more spots.
PREGAME_MINUTES=15
PREGAME_HOURS=2
# Upcoming games: every EARLY_MINUTES when they start within 24h, every FAR_MINUTES out to
# LOOKAHEAD_HOURS. One check covers every game in a sport, so this is cheap. Early lines are
# often the softest. LOOKAHEAD_HOURS=0 turns it off.
EARLY_MINUTES=60
LOOKAHEAD_HOURS=48
FAR_MINUTES=180
# Lines for games hours away can sit unchanged for a long time without being stale.
FAR_MAX_AGE_SECONDS=10800
# On a tight budget, upcoming-game checks slow down (up to this much) before live ones do, and then
# early props and games 1-2 days out slow down up to this much again before anything else does...
EXTRA_MAX_STRETCH=4
# ...except that, with LIVE_MARKETS=h2h, live checks slow down first, up to this much (3 = every 3
# minutes), so bets for games that haven't started keep their pace. Empty = locks mode: 3; other
# modes: 1. Without LIVE_MARKETS it does nothing (the live check also carries upcoming games).
# The bot's log says once a day when live checks have stayed at this for half an hour.
LIVE_MAX_STRETCH=
# On a day with credits to spare, the spare buys faster pre-game checks (never faster live ones):
# near kickoff first, then later today, early props, props near kickoff, and 1-2 days out last.
# (With PREGAME_WITH_LIVE_EVERY=2 or more, spreads/totals of later games in a sport with a live game
# come before all of those, down to every live check.)
# The fastest each may go, in minutes (0 = never faster than normal; at least 1 and at most the
# normal rate). Empty = PREGAME 3, EARLY 15, PROP_EARLY 60, PROP_NEAR 15, FAR 60.
PREGAME_MIN_MINUTES=
EARLY_MIN_MINUTES=
PROP_EARLY_MIN_MINUTES=
PROP_NEAR_MIN_MINUTES=
FAR_MIN_MINUTES=
# The faster pace may plan to use at most this % of the day's credits (0-95; 0 = no speed-ups).
# Whatever is left carries over to the coming days. (With PREGAME_WITH_LIVE_EVERY=2 or more, the
# spreads/totals of later games in a sport with a live game may use all of the day's credits: they
# used to come with every live check.)
SPARE_USE_PCT=85
# How the month's credits are shared across the week (relative, local time). Busy days get more
# speed, quiet midweek days less; the plan still lasts the month.
BUDGET_WEIGHTS=mon=1.2,tue=0.6,wed=0.6,thu=1.2,fri=1,sat=2,sun=2.2

# ---- Alerts
# locks    = only strong alerts (default): arbs 2%+ (live 5%+), +EV 5%+ at high confidence (pre-game
#            3.5%+, college 4.5%+, when Kalshi or 4+ other sportsbooks agree with Pinnacle: see
#            PREGAME_CONFIRMED_EV_PCT), props 8%+, outliers 15%+ (live 20%+), 2-leg parlays 15%+; at
#            most 4 arbs / 6 +EV / 6 props / 6 outliers / 2 parlays per hour, and 3 live alerts per
#            hour in all (games that haven't started go first). Live alerts also need 2 checks in a
#            row and a price under 60s old (LIVE_CONFIRM_CHECKS=2, LIVE_MAX_AGE_ALERT=60). Props with
#            no Pinnacle price: the other books within 2% win chance of each other, 6+ sportsbooks on
#            the line, within 12 hours, an 8-12% edge, and seen on two prop checks. Your own stricter
#            settings below still win; to loosen any of these, use ALERT_MODE=balanced with your own
#            values.
# balanced = exactly the thresholds below.   all = same as balanced (kept for clarity).
ALERT_MODE=locks
# Hourly caps on new alerts (0 = no cap). Within each, games that haven't started go first, then
# the biggest edge. The arb and outlier caps count props too.
MAX_ARB_PER_HOUR=0
MAX_EV_PER_HOUR=0
MAX_PROP_PER_HOUR=0
MAX_OUTLIER_PER_HOUR=0
MAX_PARLAY_PER_HOUR=0
# One cap for every live alert together (arbs, outliers, live +EV). Pre-game alerts never count.
LIVE_PER_HOUR=0
# Arbs must clear BOTH: a minimum % edge and a minimum dollar profit at BANKROLL.
MIN_PROFIT_PCT=0.5
MIN_PROFIT_DOLLARS=0
MAX_PROFIT_PCT=15
# Ignore prices older than this. Live games need fresh prices; pre-game lines can sit
# unchanged for a while without being stale.
MAX_AGE_SECONDS=120
PREGAME_MAX_AGE_SECONDS=900
# The same limits just for the sharp books (SHARP_BOOKS, Pinnacle), whose prices set the fair odds:
# live, within PREGAME_HOURS, and further out. Empty = the limit above (FAR_MAX_AGE_SECONDS for games
# further out), so nothing changes. A smaller number means fewer bets, but never one priced off an
# old Pinnacle line (an old time stamp usually means Pinnacle took the market down). Example:
# SHARP_PREGAME_MAX_AGE_SECONDS=300.
SHARP_MAX_AGE_SECONDS=
SHARP_PREGAME_MAX_AGE_SECONDS=
SHARP_FAR_MAX_AGE_SECONDS=
# If an open bet's edge grows by this many points, send a fresh alert (edits don't ping). A live
# one only goes out under the live rules below (and counts toward LIVE_PER_HOUR); until then the
# card is just updated. A bet that turns from +EV into an outlier (or back) gets a new card, which
# pings only if its edge is this much better than the edge last pinged for.
REALERT_JUMP_PCT=2.5
# Total you'd put on one arb (split across the bets).
BANKROLL=100
# Round stakes to this many dollars so they look like normal bets ($55, not $57.65).
# Rounding costs some edge, so it steps down ($5 -> $1 -> $0.50 -> cents) until it keeps
# at least ROUND_KEEP_PCT of the exact edge. 0 = exact cents. Alerts always show the edge
# for the stakes they print.
ROUND_STAKES=5
ROUND_KEEP_PCT=85
# Optional: your tax rate as a fraction (0.33 = 33%). Arb cards then add a rough after-tax profit,
# e.g. "After tax (~33%): about +$1.70 per $100": the winning bet's winnings are taxed and the losing
# stakes deducted at 90% (that assumes you itemize). Small arbs often come out below zero. A rough
# guide, not tax advice. 0 = off. MIN_AFTER_TAX_PCT then skips arbs under that after-tax % (0 = off).
TAX_RATE=0
MIN_AFTER_TAX_PCT=0
# How alerts show odds: american (+152 / -154) or decimal (2.52).
ODDS_FORMAT=american
# Tap-to-bet links in alerts, for books that provide them.
INCLUDE_LINKS=true
# Also ask for each book's own ids for games, markets and bets (no extra credits): when DraftKings or
# FanDuel only send the game's page (or no link), the bot builds the bet-slip link from them. --once shows how each
# book's links came out (bet slip, market page, game page, built from ids).
INCLUDE_SIDS=true
# A new alert (or a much better price's new ping) isn't sent on odds older than this many seconds by the
# time it's ready (a very slow pass, Discord making the bot wait): the next check looks again and sends it on
# fresh odds, only if it still qualifies. Before the game / live. 0 = no limit. ev_bets.csv and outliers.csv
# say how long each alert really took (post_delay, seconds from fetching its odds to its post).
SEND_MAX_DELAY_SECONDS=600
LIVE_SEND_MAX_DELAY_SECONDS=90
# When Discord asks the bot to wait longer than this before posting a new alert (rate limit), it doesn't
# wait: that alert goes out at the next check, if it's still there. 0 = always wait as long as Discord
# asks. Edits (price changes, GONE marks) and health messages always wait, since they have no next
# check.
DISCORD_MAX_WAIT_SECONDS=10
# A +EV or outlier card already posted is edited at most this often (seconds) when only other books'
# prices or its notes changed: each edit waits out Discord's limits, and with checks every minute most
# open cards would be edited every time. The next check after that edits it with the newest prices. A new
# price, book or stake for your bet, a GONE mark, a much better price (new alert), live bets, arbs and
# parlays are edited right away. 0 = every change right away. e.g. 600 = at most every 10 minutes.
CARD_EDIT_MIN_SECONDS=0
# Force a loud phone notification: @everyone, or <@YOUR_USER_ID>.
DISCORD_MENTION=
# true = games in progress only: no pre-game or prop checks at all (saves those credits).
LIVE_ONLY=false

# ---- Live arbs (games in progress)
# Live gaps are often one book lagging a few seconds and can vanish before both bets are in.
# false = pre-game arbs only. (With this and EV_LIVE both false, the bot also stops paying
# to check games in progress.)
ARB_LIVE=true
MIN_LIVE_PROFIT_PCT=1.0
# Both sides of a live arb must have been priced within this many seconds of each other;
# otherwise it's usually one book lagging, not a real arb. 0 = off.
LIVE_ARB_MAX_SKEW=60
# Live alerts (arbs, outliers, live +EV) that vanish within seconds: a new one only pings when this
# many checks in a row find it (the next check is about a minute later; 1 = off; locks: 2)...
LIVE_CONFIRM_CHECKS=1
# ...and only when the price you're told to bet was updated by its book within this many seconds
# (Pinnacle's price can be older; 0 = off; locks: 60). Alerts already up aren't closed by these,
# but a better-price re-alert on a live one has to pass them too.
LIVE_MAX_AGE_ALERT=0
# Only pay for live checks in these sports (empty = all). e.g. skip live college football:
# LIVE_SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl,baseball_mlb
LIVE_SPORTS=
# Optional: post live arbs in their own channel so pre-game alerts aren't buried.
DISCORD_LIVE_WEBHOOK_URL=

# ---- Channels (arbs always go to DISCORD_WEBHOOK_URL)
# +EV alerts, including props. Outliers and parlays also go here unless they have their own.
DISCORD_EV_WEBHOOK_URL=
DISCORD_PARLAY_WEBHOOK_URL=
# Player props (+EV and outliers) in their own channel, so lots of prop types don't crowd the +EV channel.
# Empty = they go where +EV bets and outliers go. Easiest: arbbot.py --set-webhook props
DISCORD_PROPS_WEBHOOK_URL=

# ---- +EV bets (one side priced better than Pinnacle's no-vig odds)
EV_ENABLED=true
# Sharp books for the "true" odds. List more than one to blend them, e.g.
# pinnacle,betfair_ex_eu (each one uses a slot in BOOKMAKERS).
SHARP_BOOKS=pinnacle
# How much each fair-odds source counts in a blend, e.g. pinnacle=0.7,betfair_ex_eu=0.3. Empty = the
# blueprint's trust order: pinnacle 0.5, kalshi 0.15 (Kalshi's own prices, see KALSHI_BLEND), any other
# sharp book 0.15. A source you don't list keeps that default; 0 = don't use it at all. They're shared
# out over the sources that price a line (Pinnacle + Kalshi: 77% / 23%). The bot warns at startup if one
# counts more than Pinnacle (with 3+ sources, the heaviest is the one never left out; a tie goes to
# Pinnacle).
SHARP_WEIGHTS=
# The same for player props (Kalshi has none). Empty = SHARP_WEIGHTS.
SHARP_WEIGHTS_PROPS=
# Skip a line when two sharps' fair probabilities differ by more than this many points (props:
# SHARP_DISAGREE_PROP_PCT).
SHARP_DISAGREE_PCT=3
SHARP_DISAGREE_PROP_PCT=4
# With 3 or more fair-odds sources on a line (sharp books, plus Kalshi on a pre-game moneyline), one that
# sits more than OUTLIER_SOURCE_PTS points of win chance from the middle of the others (props:
# OUTLIER_SOURCE_PROP_PTS) is left out of that line's fair price, and the rest must still agree within
# SHARP_DISAGREE_PCT. At most one per line; if it's Pinnacle (the most trusted), the line is skipped instead.
# The card says "LowVig left out (4.1 pts off)". Nothing is remembered: it counts again on the next
# check it's back in line. With only two sources, SHARP_DISAGREE_PCT (and KALSHI_MAX_GAP) decide, as before.
OUTLIER_SOURCE_PTS=3
OUTLIER_SOURCE_PROP_PTS=4
# With several sharps, bet this fraction of the normal stake when only one priced the line.
SINGLE_SOURCE_STAKE=0.5
# Bet this fraction of the normal stake when the fair price comes from one source alone: Pinnacle by
# itself (spreads, totals, props, and moneylines without a usable Kalshi price). 1 = the full stake, as
# before; 0.75 = a quarter less. A fair price from Pinnacle and Kalshi together isn't cut by this.
ONE_SOURCE_STAKE=1
# When no sharp book prices a line (most often a player prop Pinnacle doesn't offer), fair value is
# the median of at least PROP_MIN_BOOKS other books (BetOnline.ag and LowVig.ag count as one). Bet
# this fraction of the normal stake (0.7 = 30% less).
CONSENSUS_STAKE=0.7
# Kalshi second opinion (free, no key): before a game starts, the bot reads Kalshi's own exchange
# prices for game winners (NFL, college football, NBA, college basketball, NHL, MLB). A moneyline
# +EV bet is skipped when Kalshi's win chance is more than KALSHI_MAX_GAP points from Pinnacle's
# (1 more for games over a day away, 2 more for college) or says the price isn't good; outliers
# need Kalshi to agree too. Kalshi prices count only when the bid-ask spread is at most
# KALSHI_MAX_SPREAD cents (college +2) with KALSHI_MIN_SIZE contracts at each side. KALSHI_LIVE=true
# also uses it during games (its in-game prices lag, so it's off by default). A bet at Kalshi bigger
# than what Kalshi has at that price (contracts x price) gets a note on its card; a +EV or outlier
# stake is cut to what's there (an arb's stakes stay as they are).
KALSHI_CHECK=true
KALSHI_MAX_GAP=3
KALSHI_MAX_SPREAD=3
KALSHI_MIN_SIZE=100
KALSHI_LIVE=false
# Kalshi's price also goes into a pre-game moneyline's fair odds, next to Pinnacle's (weight: kalshi in
# SHARP_WEIGHTS, else 0.15), when both teams have a usable Kalshi price. Only the edge, the stake and the
# card use it ("Pinnacle + Kalshi"); the checks above still compare Kalshi with Pinnacle's own price, and a
# bet at Kalshi uses Pinnacle's alone. false = Pinnacle alone, as before.
KALSHI_BLEND=true
# Kalshi-only moneylines: when Pinnacle doesn't list a game's moneyline at all (while it does list other
# games in that sport, so it isn't down), a pre-game moneyline can be priced by Kalshi alone, if both teams
# have a usable Kalshi price and 3+ other sportsbooks (exchanges don't count) are within
# SHARP_CONSENSUS_MAX_GAP of it. It's never more than medium confidence (so never in locks mode), never a
# bet at Kalshi itself, and the stake is KALSHI_ONLY_STAKE of the normal one. The card says
# "Kalshi (no Pinnacle price)". An old Pinnacle price doesn't count as missing (it usually means
# Pinnacle took the market down).
KALSHI_ONLY=true
KALSHI_ONLY_STAKE=0.5
# Confirmed pre-game bets: a moneyline, spread or total for a game within CONFIDENT_HOURS can go out
# under MIN_EV_PCT, down to PREGAME_CONFIRMED_EV_PCT (college games 1 more), when a second sharp
# source agrees with Pinnacle's fair odds: Kalshi within KALSHI_CONFIRM_PTS points of win chance
# (moneylines), or the middle price of 4+ other sportsbooks within CONSENSUS_CONFIRM_PTS (spreads
# and totals; the book you bet at, exchanges and a second sister book don't count). The edge must
# clear it by both chances. It must still be high confidence (even with a lower MIN_CONFIDENCE),
# Pinnacle's line can't be moving against it (since an hour ago, or the last check; after a restart
# it waits one check), and every other check applies. A bet over MIN_EV_PCT only because Kalshi is
# blended into its fair price (KALSHI_BLEND) still counts as one of these: it must clear MIN_EV_PCT by
# Pinnacle's own price to skip them. The card shows "Two sharp books agree". Empty
# = the mode's choice (locks 3.5, otherwise off); 0 = off. In locks mode your values win only when
# stricter (a higher edge or 0; fewer points).
PREGAME_CONFIRMED_EV_PCT=
KALSHI_CONFIRM_PTS=1.5
CONSENSUS_CONFIRM_PTS=1.5
# How to strip the sharp's margin. "power" removes more of it from long shots, where books
# hide most of it; "multiplicative" is the simple version.
DEVIG_METHOD=power
# Bet-quality checks. Skip +EV when the sharp's own margin is wider than MAX_SHARP_HOLD_PCT
# (props get +4), or when the sharp and the other books' median disagree by more than
# SHARP_CONSENSUS_MAX_GAP points (one of them is stale). Each alert gets a confidence rating;
# stakes scale by CONFIDENCE_STAKES (high, medium, low). MIN_CONFIDENCE=medium drops the low ones.
# A prop with no Pinnacle price is rated on how closely the other books agree and how many
# sportsbooks price it. An alert that's already up stays up while it's at least medium.
MAX_SHARP_HOLD_PCT=8
SHARP_CONSENSUS_MAX_GAP=10
MIN_CONFIDENCE=low
CONFIDENCE_STAKES=1,0.75,0.5
# Games starting within this many hours can be high confidence (so tonight's and tomorrow's games
# can reach locks mode); further out they're marked "early line". Props: 12 hours.
CONFIDENT_HOURS=24
# Bigger minimum edge for sports where the sharp line is less reliable (many small games).
SPORT_MIN_EV=americanfootball_ncaaf=6,basketball_ncaab=6
# Confidence goes up when the sharp line moved 1.5+ points toward the bet in this window, down when away.
MOVE_WINDOW_MINUTES=60
# Only alert +EV at these books (empty = MY_BOOKS). Never goes outside MY_BOOKS.
EV_BOOKS=
MIN_EV_PCT=4
MAX_EV_PCT=25
# Skip long shots above these decimal odds (5.0 = +400).
EV_MAX_ODDS=5.0
# Live +EV is mostly feed-timing noise, so pre-game only by default.
EV_LIVE=false
# Money set aside for +EV betting; stakes are a fraction of it (Kelly).
EV_BANKROLL=1000
KELLY_FRACTION=0.25
# Dollars per unit (1u). Every bet card shows its stake in units too, like "$15 (1.5u)".
# 0 = 1% of EV_BANKROLL ($10 with EV_BANKROLL=1000, so 100 units = the bankroll). The unit only
# labels the stake: the dollars come from EV_BANKROLL. To scale every bet with your unit, use
#   python arbbot.py --set UNIT_SIZE=20    (it sets EV_BANKROLL=2000 too)
# If you set UNIT_SIZE here and 100 units isn't EV_BANKROLL, the bot warns at startup.
UNIT_SIZE=0
EV_MAX_STAKE_PCT=3
EV_MENTION=
EV_LOG_FILE=ev_bets.csv
EV_RESULTS_FILE=ev_results.csv
# Closing line value: the sharp's fair price at kickoff for every logged bet, and one last
# check this many minutes before kickoff for games you have a bet on (0 = off).
CLOSING_FILE=closing_lines.csv
CLOSING_MINUTES=5
# Markouts ("did the edge hold?"): every alert's price looked at again on the next checks (next,
# ~3 min, ~10 min later) against the same fair odds the alert used. Works for live bets, which CLV
# can't judge. No extra credits or pings. Empty = off.
MARKOUT_FILE=markouts.csv
# Candidate log: every +EV and outlier bet that came within 1 point of its bar and what happened to it
# (alerted, with post_delay; held back: capped, live cap, old price, unconfirmed, deferred; or the check
# that stopped it: sharp hold, market gap, kalshi gap, kalshi no, sharp no, sharp other line, sharp last
# price, confirm fail, low confidence, moved first, first look, under bar). For tuning the bars. Empty = off.
CANDIDATE_LOG_FILE=candidates.csv
# Once a day, candidates.csv, arbs.csv and markouts.csv drop rows older than this many days (0 = keep
# everything), so the markout summaries cover this many days. The bet logs (ev_bets, outliers, parlays,
# results, closing lines) and score_checks.csv are never cut.
LOG_KEEP_DAYS=60
# Only set true if you can actually bet at the sharp book (lets it be an arb leg).
BET_AT_SHARP=false

# ---- 🚨 Outliers: one book far off every other book (e.g. +400 where the rest are -400)
# Usually a book that hasn't updated yet. Compared with the median of all the other books,
# no upper limit, live games included. Alerts show a "lock it in" hedge when one exists.
OUTLIERS_ENABLED=true
OUTLIER_MIN_PCT=10
# Live outliers need at least this edge (0 = OUTLIER_MIN_PCT; locks: 20).
OUTLIER_LIVE_MIN_PCT=0
OUTLIER_MIN_BOOKS=3
# Player props: a price more than this % off the other books' median is usually bad data (a book's market that
# isn't the same bet) and is left out of outliers, +EV, arbs and parlays (0 = no cap).
OUTLIER_PROP_MAX_PCT=40
# Player props: a book off by the outlier bar on this many players of one prop type in a game, and on at least 60%
# of the players it can be compared on there, has its whole market for that game left out until it's back in line
# for 2 checks (0 = off). The sharp book is never left out.
OUTLIER_PROP_CLUSTER=4
OUTLIER_LIVE=true
# Make these loud: @everyone, or <@YOUR_USER_ID>.
OUTLIER_MENTION=
# Optional: their own channel.
DISCORD_OUTLIER_WEBHOOK_URL=
OUTLIER_LOG_FILE=outliers.csv

# ---- 🎯 Player props
# Fetched per game, so they cost more: (# prop types) credits per game per check. Checked every
# PROP_MINUTES, only in the PROP_HOURS before kickoff. The budget autopilot counts them.
PROPS_ENABLED=true
PROP_SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl
# Override the prop types for a sport: sport=market|market;sport=market|market
# e.g. PROP_MARKETS=americanfootball_nfl=player_pass_yds|player_rush_yds
# If The Odds API turns one of them down, only that one stops (until a restart): the bot finds which one
# (the API's answer names it, or each type is asked alone once; a refused call costs nothing), says so
# once in the health channel and keeps asking for the others. Only if it turns down every one does that
# sport's props stop.
PROP_MARKETS=
# Extra prop types asked for only in the last PROP_HOURS before kickoff, in the same request (each costs
# 1 more credit per game per check there, about 7 checks a game). They're paid for only with credits the
# day has to spare (the next 24h fit at full speed with them, after the near-kickoff speed-up), so they
# never slow live or main-line checks; on a short day they wait. Same format as PROP_MARKETS; empty =
# the defaults: NHL goals and goalie saves (icehockey_nhl=player_goals|player_total_saves) and NFL
# alternate lines (americanfootball_nfl=player_pass_yds_alternate|player_rush_yds_alternate|
# player_reception_yds_alternate|player_receptions_alternate). An alternate line ("250+ yards") is
# only ever a price to bet, at exactly the line Pinnacle (or the other books' main lines) prices: it
# never sets the fair odds itself. Cards say "(alternate line)"; ev_bets.csv has an alt column.
# Turn one sport's off with an empty list: PROP_NEAR_MARKETS=icehockey_nhl=
# If The Odds API rejects them, the bot asks again without them, says so once in the health channel,
# and skips them for that sport until it restarts; the sport's other props carry on. (If it rejects the
# request without them too, PROP_MARKETS is what's wrong: see PROP_MARKETS above.)
PROP_NEAR_MARKETS=
# true = those extras are paid for from spare credits only, so they never slow a live or main-line check
# (on a month that uses every credit, that's only a few near-kickoff checks). false = they're paid for
# like the rest of the near-kickoff prop check: asked for every time, and a short day slows live and
# main-line checks a little to pay for them.
PROP_NEAR_SPARE_ONLY=true
PROP_MINUTES=30
PROP_HOURS=3
# Earlier prop checks for later games: every PROP_EARLY_MINUTES from PROP_EARLY_HOURS out.
PROP_EARLY_HOURS=24
PROP_EARLY_MINUTES=240
# At most this many games' props per pass (every pass is a second or more apart): the most overdue first,
# closing-line checks before any, and the rest go in the next pass, seconds later. So a slate of games
# starting together doesn't ask The Odds API for dozens at once or hold up the next live check. 0 = no
# limit. e.g. 8.
PROP_MAX_PER_PASS=0
PROP_MIN_EV_PCT=7
# Which prop sides get alerts (+EV, outliers, and so parlays): "over" = Overs only, "both" = Overs and
# Unders. Empty = the mode's choice: over in locks mode (the blueprint), both in balanced and all.
# The Under's price still goes into the fair odds, and prop arbs still use both sides.
PROP_SIDES=
# With no Pinnacle price on a prop, use the median of at least this many OTHER books (the book being
# judged doesn't count). A new line waits one prop check before it can alert.
PROP_MIN_BOOKS=4

# ---- 📦 Parlays (2-3 current +EV bets from different games, same book)
PARLAYS_ENABLED=true
PARLAY_MAX_LEGS=3
PARLAY_MIN_EV_PCT=10
PARLAY_LEG_MIN_EV_PCT=2
PARLAY_MAX_ALERTS=3
# Max stake per parlay, as a % of EV_BANKROLL.
PARLAY_MAX_STAKE_PCT=1
PARLAY_MENTION=
PARLAY_LOG_FILE=parlays.csv

# ---- Bot health
# Online / crashed / low credits / daily summary messages. Empty = same channel as alerts.
DISCORD_STATUS_WEBHOOK_URL=
# Results (what hit and what missed), posted as games finish. Empty = the bot health channel.
# Easiest: arbbot.py --set-webhook results
DISCORD_RESULTS_WEBHOOK_URL=
# How often to look for finished games to grade (2 credits per sport that has a finished bet).
RESULTS_MINUTES=30
# Grade player props from ESPN box scores (free). "off" = check props yourself.
# Test it with: arbbot.py --check-props
PROP_GRADING=espn
# ESPN's free scoreboard next to the paid scores: "shadow" notes, once per game, whether its final
# agreed (SCORE_CHECK_FILE); results still come from the Odds API. "off" = don't ask ESPN about
# finals. Either way, run lines and totals on an MLB game that ended before the 9th (rain) are left
# for you to check (books usually void them); the moneyline is still graded.
FREE_SCORES=shadow
SCORE_CHECK_FILE=score_checks.csv
LOW_CREDITS=5000
# Outage messages in the health channel: one when a problem has lasted this many minutes, one when it's
# over. The Odds API not answering for a sport (no alerts for it meanwhile; open alerts stay up).
# Pinnacle missing from every game of a sport other books price (not just an old price): meanwhile that
# sport's main-line +EV is paused (its open +EV cards close until Pinnacle is back), Kalshi-only bets
# wait and props without a Pinnacle price are medium at most. Kalshi unreachable while games before
# kickoff need it: moneylines go out on Pinnacle alone. Also "Credits available again" after a credit
# pause. 0 = that one off; HEALTH_ALERTS=false = no messages (the Pinnacle rules still apply while it's
# missing). A failure long after the last one with nothing asked in between (night, then morning) starts
# that clock again.
HEALTH_ALERTS=true
ODDS_DOWN_MINUTES=10
SHARP_DOWN_MINUTES=15
KALSHI_DOWN_MINUTES=30
# Local hour for the daily summary (-1 = off). On Mondays the weekly report card goes to the results
# channel at this hour too: the last 7 days by alert type, with suggestions (it never changes a
# setting). See it any time with: arbbot.py --weekly
SUMMARY_HOUR=9
# Every arb: when a check first found it (spotted), when the alert went out and how long it stayed
# open after (first_seen, seconds_open), how many checks found it (checks), which bet was the price
# that would move (stale_book, stale_edge_pct), every bet's edge against Pinnacle (leg_edges) and
# how old each price was, Pinnacle's too (leg_ages; ? = not known, e.g. player props). Arbs the caps
# or live rules held back are in it too, with a reason (capped, live cap, old price, unconfirmed), and
# arbs whose alert never went out (old data: its odds were too old by sending time; not sent: Discord
# never took it). The last LOG_KEEP_DAYS (60) days are kept. Open in Excel/Sheets.
LOG_FILE=arbs.csv

# ---- Optional
# Only run during these hours. Usually not needed now: the bot already sleeps when no
# games are on. Empty = any time. Crossing midnight works (18:00-02:00).
ACTIVE_HOURS=
TIMEZONE=America/New_York
# Override how long games last if your sport differs, e.g. basketball_ncaab=140
GAME_MINUTES=
EVENTS_REFRESH_MINUTES=10
