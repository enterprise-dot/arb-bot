# Copy this file to .env and fill in the first two values. Everything else has a default.

# https://the-odds-api.com
ODDS_API_KEY=
# Discord: Channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# ---- What to watch
# Sport keys. Out-of-season sports cost nothing (no games = no checks), so list freely.
SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl,baseball_mlb
# h2h (moneyline), spreads, totals. Each one adds 1 credit per check.
MARKETS=h2h,spreads,totals
# Up to 10 books cost the same as ONE region, and they can come from any region.
# Pinnacle is only read, as the "true odds" reference for +EV; you never bet there.
# Swap in the books you have accounts at. Run `--once` to see which keys are in the feed.
# (Leave BOOKMAKERS empty to use REGIONS instead; +EV then needs the eu region for Pinnacle.)
BOOKMAKERS=pinnacle,draftkings,fanduel,betmgm,williamhill_us,espnbet,betrivers,fanatics,hardrockbet,ballybet
REGIONS=us

# ---- Your plan
MONTHLY_CREDITS=100000
# Day of the month your credits reset (check your Odds API account page).
BILLING_DAY=1

# ---- Speed
# Fastest check rate while a sport has a game in progress. The bot slows down automatically
# only if needed to make credits last until BILLING_DAY.
POLL_SECONDS=60
# Slower checks shortly before kickoff (pre-game arbs last longer). 0 = live games only.
# +EV alerts are pre-game, so these matter for +EV: more often / earlier = more spots.
PREGAME_MINUTES=15
PREGAME_HOURS=2

# ---- Alerts
MIN_PROFIT_PCT=0.5
MAX_PROFIT_PCT=15
# Ignore prices older than this. Live games need fresh prices; pre-game lines can sit
# unchanged for a while without being stale.
MAX_AGE_SECONDS=120
PREGAME_MAX_AGE_SECONDS=900
# If an open bet's edge grows by this many points, send a fresh alert (edits don't ping).
REALERT_JUMP_PCT=2.5
# Total you'd put on one arb (split across the bets).
BANKROLL=100
# Round stakes to this many dollars so they look like normal bets ($55, not $57.65).
# Rounding costs some edge, so it steps down ($5 -> $1 -> $0.50 -> cents) until it keeps
# at least ROUND_KEEP_PCT of the exact edge. 0 = exact cents. Alerts always show the edge
# for the stakes they print.
ROUND_STAKES=5
ROUND_KEEP_PCT=85
# How alerts show odds: american (+152 / -154) or decimal (2.52).
ODDS_FORMAT=american
# Tap-to-bet links in alerts, for books that provide them.
INCLUDE_LINKS=true
# Force a loud phone notification: @everyone, or <@YOUR_USER_ID>.
DISCORD_MENTION=
LIVE_ONLY=false

# ---- Live arbs (games in progress)
# Live gaps are often one book lagging a few seconds and can vanish before both bets are in.
# false = pre-game arbs only. (With this and EV_LIVE both false, the bot also stops paying
# to check games in progress.)
ARB_LIVE=true
MIN_LIVE_PROFIT_PCT=1.0
# Optional: post live arbs in their own channel so pre-game alerts aren't buried.
DISCORD_LIVE_WEBHOOK_URL=

# ---- +EV bets (one side priced better than Pinnacle's no-vig odds)
EV_ENABLED=true
# Sharp books for the "true" odds. List more than one to blend them, e.g.
# pinnacle,betfair_ex_eu (each one uses a slot in BOOKMAKERS).
SHARP_BOOKS=pinnacle
# Optional weights when blending, e.g. pinnacle=0.7,betfair_ex_eu=0.3 (default: equal).
SHARP_WEIGHTS=
# Skip a line when two sharps' fair probabilities differ by more than this many points.
SHARP_DISAGREE_PCT=3
# With several sharps, bet this fraction of the normal stake when only one priced the line.
SINGLE_SOURCE_STAKE=0.5
# How to strip the sharp's margin. "power" removes more of it from long shots, where books
# hide most of it; "multiplicative" is the simple version.
DEVIG_METHOD=power
# Only alert +EV at these books (empty = every non-sharp book above).
EV_BOOKS=
MIN_EV_PCT=4
MAX_EV_PCT=25
# Skip long shots above these decimal odds (5.0 = +400).
EV_MAX_ODDS=5.0
# Live +EV is mostly feed-timing noise, so pre-game only by default.
EV_LIVE=false
# Money set aside for +EV betting; stakes are a fraction of it (Kelly).
EV_BANKROLL=1000
KELLY_FRACTION=0.25
# Dollars per unit. Set it (e.g. 10) to also show stakes in units, like "$15 (1.5u)".
UNIT_SIZE=0
EV_MAX_STAKE_PCT=3
EV_MENTION=
EV_LOG_FILE=ev_bets.csv
EV_RESULTS_FILE=ev_results.csv
# Only set true if you can actually bet at the sharp book (lets it be an arb leg).
BET_AT_SHARP=false

# ---- Bot health
# Online / crashed / low credits / daily summary messages. Empty = same channel as alerts.
DISCORD_STATUS_WEBHOOK_URL=
LOW_CREDITS=5000
# Local hour for the daily summary (-1 = off).
SUMMARY_HOUR=9
# Every arb with how long it stayed open. Open in Excel/Sheets.
LOG_FILE=arbs.csv

# ---- Optional
# Only run during these hours. Usually not needed now: the bot already sleeps when no
# games are on. Empty = any time. Crossing midnight works (18:00-02:00).
ACTIVE_HOURS=
TIMEZONE=America/New_York
# Override how long games last if your sport differs, e.g. basketball_ncaab=140
GAME_MINUTES=
EVENTS_REFRESH_MINUTES=10
