# Copy this file to .env and fill in the first two values. Everything else has a default.

# https://the-odds-api.com
ODDS_API_KEY=
# Discord: Channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# ---- What to watch
# Sport keys. Out-of-season sports cost nothing (no games = no checks), so list freely.
SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl,baseball_mlb
# h2h (moneyline), spreads, totals. Each one adds 1 credit per check.
MARKETS=h2h,spreads,totals
# Up to 10 books cost the same as ONE region, and they can come from any region.
# Pinnacle is only read, as the "true odds" reference for +EV; you never bet there.
# Swap in the books you have accounts at. Run `--once` to see which keys are in the feed.
# (Leave BOOKMAKERS empty to use REGIONS instead; +EV then needs the eu region for Pinnacle.)
BOOKMAKERS=pinnacle,draftkings,fanduel,betmgm,williamhill_us,kalshi,espnbet,betrivers,fanatics,hardrockbet
REGIONS=us
# The books you actually bet at. Alerts only ever tell you to bet at these; the other books in
# BOOKMAKERS are only used to judge the market (true odds, consensus). Empty = all of them.
MY_BOOKS=draftkings,fanduel,betmgm,williamhill_us,kalshi
# Kalshi charges a trading fee (rate x P x (1-P) per $1 contract). Its prices are lowered by the
# fee before any comparison. 0 = ignore fees.
KALSHI_FEE_RATE=0.07
# Your state's two-letter code (nj, ny, pa, mi, il, az, co, ...). BetMGM's links are per state.
US_STATE=

# ---- Your plan
MONTHLY_CREDITS=100000
# Day of the month your credits reset (check your Odds API account page).
BILLING_DAY=1

# ---- Speed
# Fastest check rate while a sport has a game in progress. The bot slows down automatically
# only if needed to make credits last until BILLING_DAY.
POLL_SECONDS=60
# Slower checks shortly before kickoff (pre-game arbs last longer). 0 = live games only.
# +EV alerts are pre-game, so these matter for +EV: more often / earlier = more spots.
PREGAME_MINUTES=15
PREGAME_HOURS=2
# Upcoming games: every EARLY_MINUTES when they start within 24h, every FAR_MINUTES out to
# LOOKAHEAD_HOURS. One check covers every game in a sport, so this is cheap. Early lines are
# often the softest. LOOKAHEAD_HOURS=0 turns it off.
EARLY_MINUTES=60
LOOKAHEAD_HOURS=48
FAR_MINUTES=180
# Lines for games hours away can sit unchanged for a long time without being stale.
FAR_MAX_AGE_SECONDS=10800
# On a tight budget, upcoming-game checks slow down (up to this much) before live ones do.
EXTRA_MAX_STRETCH=4
# How the month's credits are shared across the week (relative, local time). Busy days get more
# speed, quiet midweek days less; the plan still lasts the month.
BUDGET_WEIGHTS=mon=1.2,tue=0.6,wed=0.6,thu=1.2,fri=1,sat=2,sun=2.2

# ---- Alerts
# locks    = only strong alerts (default): arbs 2%+ (live 3%+), +EV 5%+ at high confidence, props 8%+,
#            outliers 15%+, 2-leg parlays 15%+, and at most 6 +EV / 6 props / 2 parlays per hour
#            (best first). Your own stricter settings below still win.
# balanced = exactly the thresholds below.   all = same as balanced (kept for clarity).
ALERT_MODE=locks
MAX_EV_PER_HOUR=0
MAX_PROP_PER_HOUR=0
MAX_PARLAY_PER_HOUR=0
# Arbs must clear BOTH: a minimum % edge and a minimum dollar profit at BANKROLL.
MIN_PROFIT_PCT=0.5
MIN_PROFIT_DOLLARS=0
MAX_PROFIT_PCT=15
# Ignore prices older than this. Live games need fresh prices; pre-game lines can sit
# unchanged for a while without being stale.
MAX_AGE_SECONDS=120
PREGAME_MAX_AGE_SECONDS=900
# If an open bet's edge grows by this many points, send a fresh alert (edits don't ping).
REALERT_JUMP_PCT=2.5
# Total you'd put on one arb (split across the bets).
BANKROLL=100
# Round stakes to this many dollars so they look like normal bets ($55, not $57.65).
# Rounding costs some edge, so it steps down ($5 -> $1 -> $0.50 -> cents) until it keeps
# at least ROUND_KEEP_PCT of the exact edge. 0 = exact cents. Alerts always show the edge
# for the stakes they print.
ROUND_STAKES=5
ROUND_KEEP_PCT=85
# How alerts show odds: american (+152 / -154) or decimal (2.52).
ODDS_FORMAT=american
# Tap-to-bet links in alerts, for books that provide them.
INCLUDE_LINKS=true
# Force a loud phone notification: @everyone, or <@YOUR_USER_ID>.
DISCORD_MENTION=
# true = games in progress only: no pre-game or prop checks at all (saves those credits).
LIVE_ONLY=false

# ---- Live arbs (games in progress)
# Live gaps are often one book lagging a few seconds and can vanish before both bets are in.
# false = pre-game arbs only. (With this and EV_LIVE both false, the bot also stops paying
# to check games in progress.)
ARB_LIVE=true
MIN_LIVE_PROFIT_PCT=1.0
# Both sides of a live arb must have been priced within this many seconds of each other;
# otherwise it's usually one book lagging, not a real arb. 0 = off.
LIVE_ARB_MAX_SKEW=60
# Only pay for live checks in these sports (empty = all). e.g. skip live college football:
# LIVE_SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl,baseball_mlb
LIVE_SPORTS=
# Optional: post live arbs in their own channel so pre-game alerts aren't buried.
DISCORD_LIVE_WEBHOOK_URL=

# ---- Channels (arbs always go to DISCORD_WEBHOOK_URL)
# +EV alerts, including props. Outliers and parlays also go here unless they have their own.
DISCORD_EV_WEBHOOK_URL=
DISCORD_PARLAY_WEBHOOK_URL=

# ---- +EV bets (one side priced better than Pinnacle's no-vig odds)
EV_ENABLED=true
# Sharp books for the "true" odds. List more than one to blend them, e.g.
# pinnacle,betfair_ex_eu (each one uses a slot in BOOKMAKERS).
SHARP_BOOKS=pinnacle
# Optional weights when blending, e.g. pinnacle=0.7,betfair_ex_eu=0.3 (default: equal).
SHARP_WEIGHTS=
# Skip a line when two sharps' fair probabilities differ by more than this many points.
SHARP_DISAGREE_PCT=3
# With several sharps, bet this fraction of the normal stake when only one priced the line.
SINGLE_SOURCE_STAKE=0.5
# How to strip the sharp's margin. "power" removes more of it from long shots, where books
# hide most of it; "multiplicative" is the simple version.
DEVIG_METHOD=power
# Bet-quality checks. Skip +EV when the sharp's own margin is wider than MAX_SHARP_HOLD_PCT
# (props get +4), or when the sharp and the other books' median disagree by more than
# SHARP_CONSENSUS_MAX_GAP points (one of them is stale). Each alert gets a confidence rating;
# stakes scale by CONFIDENCE_STAKES (high, medium, low). MIN_CONFIDENCE=medium drops the low ones.
MAX_SHARP_HOLD_PCT=8
SHARP_CONSENSUS_MAX_GAP=10
MIN_CONFIDENCE=low
CONFIDENCE_STAKES=1,0.75,0.5
# Bigger minimum edge for sports where the sharp line is less reliable (many small games).
SPORT_MIN_EV=americanfootball_ncaaf=6,basketball_ncaab=6
# Confidence goes up when the sharp line moved 1.5+ points toward the bet in this window, down when away.
MOVE_WINDOW_MINUTES=60
# Only alert +EV at these books (empty = MY_BOOKS).
EV_BOOKS=
MIN_EV_PCT=4
MAX_EV_PCT=25
# Skip long shots above these decimal odds (5.0 = +400).
EV_MAX_ODDS=5.0
# Live +EV is mostly feed-timing noise, so pre-game only by default.
EV_LIVE=false
# Money set aside for +EV betting; stakes are a fraction of it (Kelly).
EV_BANKROLL=1000
KELLY_FRACTION=0.25
# Dollars per unit. Set it (e.g. 10) to also show stakes in units, like "$15 (1.5u)".
UNIT_SIZE=0
EV_MAX_STAKE_PCT=3
EV_MENTION=
EV_LOG_FILE=ev_bets.csv
EV_RESULTS_FILE=ev_results.csv
# Closing line value: the sharp's fair price at kickoff for every logged bet, and one last
# check this many minutes before kickoff for games you have a bet on (0 = off).
CLOSING_FILE=closing_lines.csv
CLOSING_MINUTES=5
# Only set true if you can actually bet at the sharp book (lets it be an arb leg).
BET_AT_SHARP=false

# ---- 🚨 Outliers: one book far off every other book (e.g. +400 where the rest are -400)
# Usually a book that hasn't updated yet. Compared with the median of all the other books,
# no upper limit, live games included. Alerts show a "lock it in" hedge when one exists.
OUTLIERS_ENABLED=true
OUTLIER_MIN_PCT=10
OUTLIER_MIN_BOOKS=3
OUTLIER_LIVE=true
# Make these loud: @everyone, or <@YOUR_USER_ID>.
OUTLIER_MENTION=
# Optional: their own channel.
DISCORD_OUTLIER_WEBHOOK_URL=
OUTLIER_LOG_FILE=outliers.csv

# ---- 🎯 Player props
# Fetched per game, so they cost more: (# prop types) credits per game per check. Checked every
# PROP_MINUTES, only in the PROP_HOURS before kickoff. The budget autopilot counts them.
PROPS_ENABLED=true
PROP_SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl
# Override the prop types for a sport: sport=market|market;sport=market|market
# e.g. PROP_MARKETS=americanfootball_nfl=player_pass_yds|player_rush_yds
PROP_MARKETS=
PROP_MINUTES=30
PROP_HOURS=3
# Earlier prop checks for later games: every PROP_EARLY_MINUTES from PROP_EARLY_HOURS out.
PROP_EARLY_HOURS=24
PROP_EARLY_MINUTES=240
PROP_MIN_EV_PCT=7
# With no Pinnacle price on a prop, use the median of at least this many books.
PROP_MIN_BOOKS=4

# ---- 📦 Parlays (2-3 current +EV bets from different games, same book)
PARLAYS_ENABLED=true
PARLAY_MAX_LEGS=3
PARLAY_MIN_EV_PCT=10
PARLAY_LEG_MIN_EV_PCT=2
PARLAY_MAX_ALERTS=3
# Max stake per parlay, as a % of EV_BANKROLL.
PARLAY_MAX_STAKE_PCT=1
PARLAY_MENTION=
PARLAY_LOG_FILE=parlays.csv

# ---- Bot health
# Online / crashed / low credits / daily summary messages. Empty = same channel as alerts.
DISCORD_STATUS_WEBHOOK_URL=
LOW_CREDITS=5000
# Local hour for the daily summary (-1 = off).
SUMMARY_HOUR=9
# Every arb with how long it stayed open. Open in Excel/Sheets.
LOG_FILE=arbs.csv

# ---- Optional
# Only run during these hours. Usually not needed now: the bot already sleeps when no
# games are on. Empty = any time. Crossing midnight works (18:00-02:00).
ACTIVE_HOURS=
TIMEZONE=America/New_York
# Override how long games last if your sport differs, e.g. basketball_ncaab=140
GAME_MINUTES=
EVENTS_REFRESH_MINUTES=10
