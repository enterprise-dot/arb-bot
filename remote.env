# Settings pushed for you through the automatic updates (Claude can't log into the server).
# They win over .env while they're listed here. To use only your own .env settings instead:
#   sudo -u arbbot python3 /opt/arb-bot/arbbot.py --set REMOTE_SETTINGS=off && systemctl restart arbbot
#
# Flood mode (asked for Sun Oct 4): like Saturday, plus more pre-game and MLB playoff props. No hourly caps, no live
# two-check rule, no live price-age rule.
ALERT_MODE=balanced
# Pre-game +EV from 4% (Mon Oct 5: 3% edges were too common), medium confidence allowed (🟡, 25% smaller
# stake). Low confidence still skipped.
MIN_EV_PCT=4
MIN_CONFIDENCE=medium
MAX_EV_PER_HOUR=0
# Player props from 7%.
PROP_MIN_EV_PCT=7
# Props for NFL, NBA, NHL and MLB (playoffs). No college props: New York's sportsbooks can't offer them.
PROP_SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl,baseball_mlb
# If credits ever get tight, soccer is the first thing dropped (back once there's room), before any other check slows.
SHED_SPORTS=soccer
MAX_PROP_PER_HOUR=0
# Arbs from 2% (live 3%); outliers from 10%, before the game only. Live outliers are off: in the 24 hours to
# Mon Oct 5 10pm they went 7-20 (MLB 4-9, NFL 2-7, NHL 1-4), their prices mostly gone within a check.
# OUTLIER_LIVE=true turns them back on.
MIN_PROFIT_PCT=2
MIN_LIVE_PROFIT_PCT=3
MAX_ARB_PER_HOUR=0
OUTLIER_MIN_PCT=10
OUTLIER_LIVE=false
MAX_OUTLIER_PER_HOUR=0
# Live: no hourly limit, no waiting for a second check, no price-age limit (as on Saturday).
LIVE_PER_HOUR=0
LIVE_CONFIRM_CHECKS=1
LIVE_MAX_AGE_ALERT=0
#
# The $119 plan (5,000,000 credits a month), upgraded Mon Oct 5 ("add all the extra perks"). These checks would
# use up a 100,000-credit plan in days.
#
# Sports: the five you had, plus men's college basketball. Its season starts in November; until its games are on
# the schedule it costs nothing. As in college football: a college +EV bet still needs a 6% edge (an outlier, like
# any other, needs 10% against the other books and 4% against Pinnacle's price when Pinnacle has one), and New
# York's sportsbooks are left out of games with a New York college team (Kalshi still counts).
# Oct 9: plus soccer (Premier League, Champions League, MLS, La Liga, Bundesliga, Serie A): moneyline (home, draw,
# away), spreads and totals, priced against Pinnacle like the rest. No soccer props (the bot can't grade them).
SPORTS=americanfootball_nfl,americanfootball_ncaaf,basketball_nba,icehockey_nhl,baseball_mlb,basketball_ncaab,soccer_epl,soccer_uefa_champs_league,soccer_usa_mls,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a
# The plan's size, and the day of the month its credits reset: the 1st at midnight UTC (Odds API account page),
# not the invoice date. The bot reads the credits left from every answer; these only set how it spreads them out.
MONTHLY_CREDITS=5000000
BILLING_DAY=1
# Warn in the health channel when fewer than 250,000 credits are left.
LOW_CREDITS=250000
# How the month's credits are shared across the week. NBA, NHL and college basketball play every night, so
# weekdays get almost as much as weekends now (was mon 1.2, tue 0.6, wed 0.6, thu 1.2, fri 1, sat 2, sun 2.2).
BUDGET_WEIGHTS=mon=1,tue=1,wed=1,thu=1,fri=1.1,sat=1.3,sun=1.3
# Live games: every 40 seconds. The Odds API refreshes live odds every 40 seconds, so checking faster brings
# nothing new.
POLL_SECONDS=40
# Every game in the next 48 hours: moneylines, spreads and totals every minute (the Odds API refreshes them
# every minute before games). One check covers every game of a sport: 3 credits.
PREGAME_MINUTES=1
EARLY_MINUTES=1
FAR_MINUTES=1
LOOKAHEAD_HOURS=48
# No speed-ups from spare credits: they would plan to spend most of the plan. Each floor is the pace above.
PREGAME_MIN_MINUTES=1
EARLY_MIN_MINUTES=1
FAR_MIN_MINUTES=1
# Player props: every 3 minutes in the last 8 hours before the game (Oct 9: was every 5 minutes in the last 12; prop
# prices move most near kickoff, and this costs about the same), every 30 minutes from 48 hours out.
PROP_MINUTES=3
PROP_NEAR_MIN_MINUTES=3
PROP_HOURS=8
PROP_EARLY_MINUTES=30
PROP_EARLY_MIN_MINUTES=30
PROP_EARLY_HOURS=48
# Prop types, each with its alternate lines (the "_alternate" ones), on every check. A prop type no book has
# posted yet costs nothing; each one with prices costs 1 credit per game per check.
# NFL: passing yards, TDs, completions, attempts and interceptions; rushing yards and attempts; receptions;
# receiving yards; rushing + receiving yards; anytime TD; rushing TDs and receiving TDs (Oct 9). Also (Oct 9): longest
# rush and reception, passing + rushing yards, passing + rushing + receiving yards and TDs, and the kicker's field
# goals, extra points and points. (Defense props are left out on purpose; the bot can grade them if they're added.)
# NBA: points, rebounds, assists, threes, the four combos (points+rebounds+assists, points+rebounds,
# points+assists, rebounds+assists), blocks, steals, blocks+steals, turnovers; field goals made, free throws made
# and attempted, double-double and triple-double (Oct 9).
# NHL: points, shots on goal, assists, goals, goalie saves, blocked shots, anytime goal scorer.
# MLB: hits, total bases, home runs, RBIs, runs, walks, batter strikeouts (Oct 9), hits+runs+RBIs; pitcher strikeouts,
# outs, earned runs,
# hits allowed and walks.
# If the Odds API ever turns one down, only that one stops (until a restart) and the health channel says which.
PROP_MARKETS=americanfootball_nfl=player_pass_yds|player_pass_tds|player_pass_completions|player_pass_attempts|player_pass_interceptions|player_rush_yds|player_rush_attempts|player_receptions|player_reception_yds|player_rush_reception_yds|player_anytime_td|player_rush_tds|player_reception_tds|player_rush_longest|player_reception_longest|player_pass_rush_yds|player_pass_rush_reception_yds|player_pass_rush_reception_tds|player_field_goals|player_pats|player_kicking_points|player_pass_yds_alternate|player_pass_tds_alternate|player_pass_completions_alternate|player_pass_attempts_alternate|player_rush_yds_alternate|player_rush_attempts_alternate|player_receptions_alternate|player_reception_yds_alternate|player_rush_reception_yds_alternate|player_rush_tds_alternate|player_reception_tds_alternate|player_rush_longest_alternate|player_reception_longest_alternate|player_pass_rush_yds_alternate|player_pass_rush_reception_yds_alternate;basketball_nba=player_points|player_rebounds|player_assists|player_threes|player_points_rebounds_assists|player_points_rebounds|player_points_assists|player_rebounds_assists|player_blocks|player_steals|player_blocks_steals|player_turnovers|player_field_goals|player_frees_made|player_frees_attempts|player_double_double|player_triple_double|player_points_alternate|player_rebounds_alternate|player_assists_alternate|player_threes_alternate|player_points_rebounds_assists_alternate|player_points_rebounds_alternate|player_points_assists_alternate|player_rebounds_assists_alternate|player_blocks_alternate|player_steals_alternate|player_turnovers_alternate;icehockey_nhl=player_points|player_shots_on_goal|player_assists|player_goals|player_total_saves|player_blocked_shots|player_goal_scorer_anytime|player_points_alternate|player_shots_on_goal_alternate|player_assists_alternate|player_goals_alternate|player_total_saves_alternate|player_blocked_shots_alternate;baseball_mlb=batter_hits|batter_total_bases|pitcher_strikeouts|batter_home_runs|batter_rbis|batter_runs_scored|batter_walks|batter_strikeouts|batter_hits_runs_rbis|pitcher_outs|pitcher_earned_runs|pitcher_hits_allowed|pitcher_walks|batter_hits_alternate|batter_total_bases_alternate|batter_rbis_alternate|batter_runs_scored_alternate|batter_home_runs_alternate|batter_walks_alternate|batter_hits_runs_rbis_alternate|batter_strikeouts_alternate|pitcher_strikeouts_alternate
# Nothing extra near kickoff: NHL goals and saves and the NFL alternate lines are in the list above now.
PROP_NEAR_MARKETS=icehockey_nhl=;americanfootball_nfl=
# At most 8 games' props per pass, the most overdue first (the rest follow seconds later), so a slate of games
# starting together doesn't hit the Odds API all at once or hold up the next live check.
PROP_MAX_PER_PASS=8
# A +EV or outlier card already posted is refreshed at most every 10 minutes when only other books' prices or
# notes change (Discord limits how fast the bot can edit). A new price or stake for your bet, a GONE mark, a much
# better price (new alert) and live cards: right away. (With ONE_ALERT_PER_BET below, cards stay as they went out.)
CARD_EDIT_MIN_SECONDS=600
#
# EV BOT changes (Oct 8, 2026):
# No arbs at all, main lines or props (a price gap that's also a +EV bet still goes out as +EV).
ARBS_ENABLED=false
# One alert per bet: never again at a better price, at another book, as an outlier, or after a restart. The card
# isn't edited after it goes out, except to mark it GONE.
ONE_ALERT_PER_BET=true
# Results: one card per finished New York day, between 12:30 and 1:00am. Nothing as bets settle.
RESULTS_DAILY_ONLY=true
# Each new +EV, prop, outlier and parlay card pings the Discord role of the book it's at, and only that role
# (no more @everyone on outliers). Edits never ping.
BOOK_ROLES=DraftKings=1557947182290837534,FanDuel=1557947301568184483,BetMGM=1557947490681225256,Caesars=1557947688731934750,Kalshi=1557947752770441356
# Tuning from the bot's own record, by book and sport (Oct 9): a book whose price is usually gone by the next check
# needs 2 more points of edge; one that clearly beats the closing line gets 25% bigger stakes, one that clearly
# loses to it half. Nothing changes until there are enough bets (30 for prices, 50 for CLV).
TUNE_ENABLED=true
# Tuning only learns from bets alerted from Oct 9 on: before the Oct 8 fix, BetMGM's NHL points props were priced like
# goals props, which made BetMGM and the NHL look far better than they are.
TUNE_SINCE=2026-10-09
#
# Oct 10: bets on one game win and lose together. The first 2 alerts on a game at full stake, the 3rd and 4th at half,
# no more than 4 per game (game lines and props together).
SAME_GAME_FULL=2
SAME_GAME_MAX=4
# The public results page lives here (GitHub Pages). Its token is on the server only (--set RESULTS_SITE_TOKEN=...).
RESULTS_SITE_REPO=joeybuffo10-wq/ev-bot-results
