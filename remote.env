# Settings pushed for you through the automatic updates (Claude can't log into the server).
# They win over .env while they're listed here. To use only your own .env settings instead:
#   sudo -u arbbot python3 /opt/arb-bot/arbbot.py --set REMOTE_SETTINGS=off && systemctl restart arbbot
#
# Flood mode (asked for Sun Oct 4): like Saturday, plus more pre-game and MLB playoff props. No hourly caps, no live
# two-check rule, no live price-age rule.
ALERT_MODE=balanced
# Pre-game +EV from 3%, medium confidence allowed (🟡, 25% smaller stake). Low confidence still skipped.
MIN_EV_PCT=3
MIN_CONFIDENCE=medium
MAX_EV_PER_HOUR=0
# Player props from 6%.
PROP_MIN_EV_PCT=6
# MLB playoff props too (hits, total bases, strikeouts), about 3 credits a check per game.
PROP_SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl,baseball_mlb
MAX_PROP_PER_HOUR=0
# Arbs from 2% (live 3%); outliers from 10%, live and pre-game (Saturday afternoon's level).
MIN_PROFIT_PCT=2
MIN_LIVE_PROFIT_PCT=3
MAX_ARB_PER_HOUR=0
OUTLIER_MIN_PCT=10
OUTLIER_LIVE_MIN_PCT=0
MAX_OUTLIER_PER_HOUR=0
# Live: no hourly limit, no waiting for a second check, no price-age limit (as on Saturday).
LIVE_PER_HOUR=0
LIVE_CONFIRM_CHECKS=1
LIVE_MAX_AGE_ALERT=0
#
# Upgraded plan (Mon Oct 5): The Odds API $119 plan, 5 million credits a month. Spare credits now
# push checks down to these floors (the budget autopilot still slows them if credits ever run short):
MONTHLY_CREDITS=5000000
# Credits reset on the 1st of each month at midnight UTC (Odds API account page), not the invoice date.
BILLING_DAY=1
# Main lines for every game within 48h: about every minute (live games stay every 60s).
PREGAME_MIN_MINUTES=1
EARLY_MIN_MINUTES=1
FAR_MIN_MINUTES=5
# Props every 5 minutes in the last 6 hours, every 30 minutes from 2 days out.
PROP_HOURS=6
PROP_NEAR_MIN_MINUTES=5
PROP_EARLY_HOURS=48
PROP_EARLY_MIN_MINUTES=30
