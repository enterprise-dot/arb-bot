# Settings pushed for you through the automatic updates (Claude can't log into the server).
# They win over .env while they're listed here. To use only your own .env settings instead:
#   sudo -u arbbot python3 /opt/arb-bot/arbbot.py --set REMOTE_SETTINGS=off && systemctl restart arbbot
#
# Game day (Sun Oct 4): lots of picks, pre-game first, live mixed in.
ALERT_MODE=balanced
# Pre-game +EV from 3% (locks: 5%), medium confidence allowed (🟡, 25% smaller stake).
MIN_EV_PCT=3
MIN_CONFIDENCE=medium
MAX_EV_PER_HOUR=12
# Player props from 6% (locks: 8%).
PROP_MIN_EV_PCT=6
MAX_PROP_PER_HOUR=10
# Arbs from 2%; outliers from 12% before kickoff.
MIN_PROFIT_PCT=2
MAX_ARB_PER_HOUR=6
OUTLIER_MIN_PCT=12
MAX_OUTLIER_PER_HOUR=8
# Live, mixed in: up to 8 an hour, live arbs 3%+, live outliers 15%+, and still only once two checks
# in a row find it with a price under 60 seconds old (so it's there when you tap it).
LIVE_PER_HOUR=8
LIVE_CONFIRM_CHECKS=2
LIVE_MAX_AGE_ALERT=60
MIN_LIVE_PROFIT_PCT=3
OUTLIER_LIVE_MIN_PCT=15
